# ParkSight Production — Hacklytics 2026

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Gemini Embeddings (Polaris semantic search)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google Maps Places API (POI enrichment)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Actian VectorAI DB
VECTORDB_HOST=localhost:50051
VECTORDB_COLLECTION=polaris_hex_cells

# Frontend — SET THIS TO VULTR IP BEFORE BUILDING
NEXT_PUBLIC_API_URL=http://YOUR_VULTR_PUBLIC_IP:8000
